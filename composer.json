{
  "name": "akyos/theme-renova",
  "type": "wordpress-theme",
  "license": "MIT",
  "description": "Thème parent Access Renova (Sage / Acorn / Vite)",
  "homepage": "https://github.com/akyoscommunication/theme-renova",
  "authors": [
    {
      "name": "Akyos Communication",
      "email": "dev@akyos.com",
      "homepage": "https://akyos.com"
    }
  ],
  "keywords": [
    "wordpress",
    "theme",
    "sage",
    "akyos",
    "access"
  ],
  "support": {
    "issues": "https://github.com/akyoscommunication/theme-renova/issues",
    "source": "https://github.com/akyoscommunication/theme-renova"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "require": {
    "php": "^8.3",
    "akyos/akyos-access": "dev-main",
    "akyos/akyos-x-core": "dev-main",
    "roots/acorn": "^3.1",
    "vinkla/extended-acf": "*"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.7.1"
  },
  "suggest": {
    "log1x/sage-directives": "A collection of useful Blade directives for WordPress and Sage (^1.0).",
    "log1x/sage-svg": "A useful SVG directive for inlining SVG's within Blade views (^1.0)."
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "lint": [
      "phpcs --extensions=php --standard=PSR12 app"
    ]
  },
  "extra": {
    "acorn": {
      "providers": [
        "App\\Providers\\AkyosServiceProvider",
        "Akyos\\Core\\Providers\\CommandsProvider"
      ]
    },
    "installer-name": "akyos-sage"
  }
}
